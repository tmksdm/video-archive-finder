<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VideoArchiveFinder.Application\VideoArchiveFinder.Application.csproj" />
    <ProjectReference Include="..\VideoArchiveFinder.Infrastructure\VideoArchiveFinder.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>VideoArchiveFinder</AssemblyName>
	<Product>Video Archive Finder</Product>
  </PropertyGroup>

	<ItemGroup>
		<Content Include="..\..\external\ffmpeg\bin\ffmpeg.exe"
				 Condition="Exists('..\..\external\ffmpeg\bin\ffmpeg.exe')">
			<Link>app\tools\ffmpeg.exe</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>

		<Content Include="..\..\external\ffmpeg\bin\ffprobe.exe"
				 Condition="Exists('..\..\external\ffmpeg\bin\ffprobe.exe')">
			<Link>app\tools\ffprobe.exe</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>

		<Content Include="..\..\external\ffmpeg\licenses\**\*"
				 Condition="Exists('..\..\external\ffmpeg\licenses')">
			<Link>app\licenses\ffmpeg\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
	</ItemGroup>

</Project>
