<Window x:Class="VideoArchiveFinder.Desktop.Views.CacheSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кэш миниатюр"
        Width="560"
        SizeToContent="Height"
        MinWidth="460"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Loaded="CacheSettingsDialog_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="Кэш миниатюр"/>

        <TextBlock Grid.Row="1"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Text="Миниатюры хранятся отдельно от видеоархива. Очистка кэша не изменяет видеофайлы; миниатюры будут созданы заново по мере необходимости."/>

        <TextBlock x:Name="CachePathText"
                   Grid.Row="2"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap"
                   ToolTip="Расположение кэша миниатюр"
                   Text="Путь: —"/>

        <TextBlock x:Name="CacheInfoText"
                   Grid.Row="3"
                   Margin="0,7,0,0"
                   TextWrapping="Wrap"
                   Text="Размер и количество файлов вычисляются..."/>

        <StackPanel Grid.Row="4"
                    Margin="0,16,0,0"
                    Orientation="Horizontal">

            <Button x:Name="OpenFolderButton"
                    Width="150"
                    Height="34"
                    Click="OpenFolderButton_Click"
                    Content="Открыть папку"/>

            <Button x:Name="ClearCacheButton"
                    Width="150"
                    Height="34"
                    Margin="10,0,0,0"
                    Click="ClearCacheButton_Click"
                    Content="Очистить кэш..."/>
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">

            <Button Width="100"
                    Height="34"
                    IsCancel="True"
                    Content="Закрыть"/>
        </StackPanel>
    </Grid>
</Window>
