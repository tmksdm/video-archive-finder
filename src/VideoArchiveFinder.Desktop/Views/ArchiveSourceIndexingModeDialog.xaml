<Window x:Class="VideoArchiveFinder.Desktop.Views.ArchiveSourceIndexingModeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Что индексировать"
        Width="560"
        SizeToContent="Height"
        MinWidth="460"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="Что искать в этом источнике?"/>

        <TextBlock x:Name="SourcePathText"
                   Grid.Row="1"
                   Margin="0,8,0,0"
                   Foreground="#4B5563"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <RadioButton x:Name="FolderNamesOption"
                         Margin="0,0,0,10"
                         IsChecked="True"
                         Content="Только названия папок"/>
            <RadioButton x:Name="VideoFileNamesOption"
                         Margin="0,0,0,10"
                         Content="Только имена видеофайлов"/>
            <RadioButton x:Name="BothOption"
                         Content="Названия папок и имена видеофайлов"/>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Margin="0,14,0,0"
                   Foreground="#4B5563"
                   TextWrapping="Wrap"
                   Text="Индексирование имён файлов заметно увеличит время первого обхода. Служебная структура папок сохранится во всех режимах."/>

        <StackPanel Grid.Row="4"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="100"
                    Height="34"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Content="Отмена"/>
            <Button Width="100"
                    Height="34"
                    IsDefault="True"
                    Click="AddButton_Click"
                    Content="Добавить"/>
        </StackPanel>
    </Grid>
</Window>
