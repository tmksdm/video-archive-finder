<Window x:Class="VideoArchiveFinder.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:VideoArchiveFinder.Desktop.Controls"
        Title="Video Archive Finder"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F3F4F6">


        <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>



    <Border Grid.Row="0"
                Padding="12"
                Background="White"
                BorderBrush="#D1D5DB"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <TextBox Grid.Column="0"
                         Height="40"
                         Padding="12,6"
                         VerticalContentAlignment="Center"
                         FontSize="16"
Text="{Binding Search.SearchText,
               UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Поиск по названиям папок"/>

                <ComboBox Grid.Column="1"
          Width="160"
          Height="40"
          Margin="8,0,0,0"
          Padding="8,4"
          VerticalContentAlignment="Center"
          ItemsSource="{Binding Search.SearchModes}"
          DisplayMemberPath="DisplayName"
          SelectedValuePath="Mode"
          SelectedValue="{Binding Search.SearchMode,
                                  Mode=TwoWay}"
          ToolTip="Режим поиска"
          AutomationProperties.Name="Режим поиска"/>


                <Button Grid.Column="2"
        Width="40"
        Height="40"
        Margin="8,0,0,0"
        ToolTip="Настройки"
        AutomationProperties.Name="Настройки">
                    <materialDesign:PackIcon Kind="Cog"
                             Width="20"
                             Height="20"/>
                </Button>

            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" MinWidth="220"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="3.8*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
      Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
               VerticalAlignment="Center"
               FontSize="17"
               FontWeight="SemiBold"
               Text="Источники"/>

                        <Button Grid.Column="1"
            Width="32"
            Height="32"
            Padding="4"
            Command="{Binding AddLocalFolderCommand}"
            ToolTip="Добавить локальную папку"
            AutomationProperties.Name="Добавить локальную папку">
                            <materialDesign:PackIcon Width="19"
                                 Height="19"
                                 Kind="FolderPlus"/>
                        </Button>

                        <Button Grid.Column="2"
            Width="32"
            Height="32"
            Margin="4,0,0,0"
            Padding="4"
            Command="{Binding AddUncPathCommand}"
            ToolTip="Добавить сетевой UNC-путь"
            AutomationProperties.Name="Добавить сетевой UNC-путь">
                            <materialDesign:PackIcon Width="19"
                                 Height="19"
                                 Kind="Lan"/>
                        </Button>
                    </Grid>




                    <Grid Grid.Row="1">
                        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#6B7280"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Text="Загрузка источников архива...">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                            Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoadingSources}"
                                     Value="True">
                                            <Setter Property="Visibility"
                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#6B7280"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Text="Источники архива пока не добавлены">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                            Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoadingSources}"
                                     Value="True">
                                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding HasSources}"
                                     Value="True">
                                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ListBox x:Name="ArchiveSourcesList"
         ItemsSource="{Binding Sources}"
         SelectionMode="Extended"
         PreviewKeyDown="ArchiveSourcesList_PreviewKeyDown"
                 BorderThickness="0"
                 Background="Transparent"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">

                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility"
                            Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSources}"
                                     Value="True">
                                            <Setter Property="Visibility"
                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>

                            <ListBox.ItemTemplate>
                                <DataTemplate>


                                    <Grid Margin="4,6"
      Background="Transparent"
      Tag="{Binding DataContext,
                    RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
      PreviewMouseRightButtonDown="ArchiveSourceCard_PreviewMouseRightButtonDown">



                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Индексировать папки"
          ToolTip="Запустить или повторить индексирование папок источника"
          AutomationProperties.Name="Индексировать папки источника"
          Command="{Binding PlacementTarget.Tag.StartIndexingCommand,
                            RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
          CommandParameter="{Binding PlacementTarget.DataContext,
                                     RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                                    <MenuItem.Icon>
                                                        <materialDesign:PackIcon Kind="DatabaseRefreshOutline"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>

                                                <MenuItem Header="Отменить индексирование"
          ToolTip="Остановить текущее индексирование источника"
          AutomationProperties.Name="Отменить индексирование источника"
          Command="{Binding PlacementTarget.Tag.CancelIndexingCommand,
                            RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
          CommandParameter="{Binding PlacementTarget.DataContext,
                                     RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                                    <MenuItem.Icon>
                                                        <materialDesign:PackIcon Kind="Cancel"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>

                                                <Separator/>

                                                <MenuItem Header="Открыть в Проводнике"
                  Command="{Binding PlacementTarget.Tag.OpenArchiveSourceCommand,
                                    RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                  CommandParameter="{Binding PlacementTarget.DataContext,
                                             RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                                    <MenuItem.Icon>
                                                        <materialDesign:PackIcon Width="16"
                                         Height="16"
                                         Kind="FolderOpen"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>

                                                <MenuItem Header="Копировать полный путь"
          ToolTip="Копировать полный путь источника"
          AutomationProperties.Name="Копировать полный путь источника"
          Command="{Binding PlacementTarget.Tag.CopyArchiveSourcePathCommand,
                            RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
          CommandParameter="{Binding PlacementTarget.DataContext,
                                     RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                                    <MenuItem.Icon>
                                                        <materialDesign:PackIcon Width="16"
                                 Height="16"
                                 Kind="ContentCopy"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>


                                                <Separator/>

                                                <MenuItem Header="Удалить выбранные источники из приложения…"
                  Foreground="#B91C1C"
                  Click="RemoveSelectedArchiveSources_Click">
                                                    <MenuItem.Icon>
                                                        <materialDesign:PackIcon Width="16"
                                         Height="16"
                                         Foreground="#B91C1C"
                                         Kind="Delete"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Grid.ContextMenu>



                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>


                                        <TextBlock Grid.Row="0"
                       FontWeight="SemiBold"
                       Text="{Binding DisplayName}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding DisplayName}"/>

                                        <StackPanel Grid.Row="1"
                        Margin="0,3,0,0"
                        Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center"
                           Foreground="#6B7280"
                           FontSize="12"
                           Text="{Binding SourceTypeShortText}"
                           ToolTip="{Binding SourceTypeText}"/>

                                            <TextBlock Margin="8,0,5,0"
                           VerticalAlignment="Center"
                           Foreground="{Binding AvailabilityColor}"
                           FontSize="12"
                           Text="●"
                           ToolTip="{Binding AvailabilityToolTip}"/>

                                            <TextBlock VerticalAlignment="Center"
                           Foreground="{Binding AvailabilityColor}"
                           FontSize="12"
                           Text="{Binding AvailabilityText}"
                           ToolTip="{Binding AvailabilityToolTip}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="2"
                       Margin="0,3,0,0"
                       Foreground="#4B5563"
                       FontSize="12"
                       Text="{Binding FullPath}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding FullPath}"/>

                                        <StackPanel Grid.Row="3"
            Margin="0,5,0,0">

                                            <ProgressBar Height="3"
                 Margin="0,0,0,5"
                 IsIndeterminate="True">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Visibility"
                        Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsIndexing}"
                                 Value="True">
                                                                <Setter Property="Visibility"
                                Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>

                                            <TextBlock FontSize="12"
               FontWeight="SemiBold"
               Foreground="#374151"
               Text="{Binding IndexingStatusText}"
               TextTrimming="CharacterEllipsis"
               ToolTip="{Binding IndexingStatusText}"/>

                                            <TextBlock Margin="0,2,0,0"
               FontSize="11"
               Foreground="#6B7280"
               Text="{Binding IndexingSummaryText}"
               TextTrimming="CharacterEllipsis"
               ToolTip="{Binding IndexingSummaryText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility"
                        Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasIndexingDetails}"
                                 Value="True">
                                                                <Setter Property="Visibility"
                                Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Margin="0,2,0,0"
               FontSize="11"
               Foreground="#6B7280"
               Text="{Binding CurrentIndexingPath}"
               TextTrimming="CharacterEllipsis"
               ToolTip="{Binding CurrentIndexingPath}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility"
                        Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasCurrentIndexingPath}"
                                 Value="True">
                                                                <Setter Property="Visibility"
                                Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                        </StackPanel>




                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>


                        </ListBox>
                    </Grid>
                </Grid>

            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True"/>

            <Border Grid.Column="2"
        Padding="12"
        Background="White"
        BorderBrush="#D1D5DB"
        BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>



                    <TextBlock x:Name="SearchResultsTitle"
           Grid.Row="0"
           FontSize="17"
           FontWeight="SemiBold"
           Text="Результаты поиска"/>


                    <TextBlock x:Name="SearchResultsSummary"
           Grid.Row="1"
           Margin="0,8,0,10"
           Foreground="#4B5563"
           Text="{Binding Search.ResultsSummary}"/>


                    <TreeView x:Name="SearchResultsTree"
          Grid.Row="2"
          ItemsSource="{Binding Search.Results}"
          BorderThickness="0"
          Background="Transparent"
          HorizontalContentAlignment="Stretch"
          ScrollViewer.CanContentScroll="True"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          VirtualizingPanel.IsVirtualizing="True"
          VirtualizingPanel.VirtualizationMode="Recycling">


                        <TreeView.Resources>
                            <SolidColorBrush
        x:Key="{x:Static SystemColors.HighlightBrushKey}"
        Color="#DBEAFE"/>

                            <SolidColorBrush
        x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
        Color="#111827"/>

                            <SolidColorBrush
        x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
        Color="#E5E7EB"/>

                            <SolidColorBrush
        x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
        Color="#111827"/>
                        </TreeView.Resources>


                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded"
                    Value="True"/>
                                <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
                                <Setter Property="Padding"
                    Value="0"/>
                                <Setter Property="Margin"
                    Value="0"/>
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate
            ItemsSource="{Binding Children}">

                            <Border
    PreviewMouseLeftButtonDown="FolderSearchNode_PreviewMouseLeftButtonDown" Padding="6,5"
                    Background="Transparent"
                    ToolTip="{Binding FullPath}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <materialDesign:PackIcon
                        Grid.Column="0"
                        Width="17"
                        Height="17"
                        Margin="0,1,7,0"
                        VerticalAlignment="Top"
                        Kind="FolderOutline">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Foreground"
                                        Value="#9CA3AF"/>

                                                    <Style.Triggers>
                                                        <DataTrigger
                                        Binding="{Binding IsMatch}"
                                        Value="True">
                                                            <Setter Property="Kind"
                                                Value="FolderSearchOutline"/>
                                                            <Setter Property="Foreground"
                                                Value="#2563EB"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>

                                        <StackPanel Grid.Column="1">
                                            <controls:HighlightedTextBlock
                                   Segments="{Binding NameSegments}"
                                   AutomationProperties.Name="{Binding Name}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FullPath}">
                                                <controls:HighlightedTextBlock.Style>
                                                    <Style TargetType="{x:Type controls:HighlightedTextBlock}">
                                                        <Setter Property="FontSize"
                                            Value="14"/>
                                                        <Setter Property="FontWeight"
                                            Value="Normal"/>
                                                        <Setter Property="Foreground"
                                            Value="#6B7280"/>

                                                        <Style.Triggers>
                                                            <DataTrigger
                                            Binding="{Binding IsMatch}"
                                            Value="True">
                                                                <Setter Property="FontSize"
                                                    Value="15"/>
                                                                <Setter Property="FontWeight"
                                                    Value="SemiBold"/>
                                                                <Setter Property="Foreground"
                                                    Value="#111827"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:HighlightedTextBlock.Style>
                                            </controls:HighlightedTextBlock>

                                            <TextBlock Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Text="{Binding FullPath}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FullPath}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                                        <Style.Triggers>
                                                            <DataTrigger
                                            Binding="{Binding IsMatch}"
                                            Value="True">
                                                                <Setter Property="Visibility"
                                                    Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>


                    <Border x:Name="VideoFilesPanel"
        Grid.Row="0"
        Grid.RowSpan="3"
        Visibility="Collapsed"
        BorderThickness="0">

                        <Grid Margin="8,8,4,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
            Width="32"
            Height="32"
            Margin="0,0,8,0"
            Padding="4"
            Click="ReturnToSearchResults_Click"
            ToolTip="Вернуться к результатам поиска"
            AutomationProperties.Name="Вернуться к результатам поиска">
                                    <materialDesign:PackIcon Width="19"
                                 Height="19"
                                 Kind="ArrowLeft"/>
                                </Button>

                                <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               FontSize="17"
               FontWeight="SemiBold"
               Text="{Binding VideoFiles.SelectedFolder.Name}"
               TextTrimming="CharacterEllipsis"
               ToolTip="{Binding VideoFiles.SelectedFolder.Name}"/>
                            </Grid>


                            <TextBlock Grid.Row="1"
                   Margin="0,3,0,0"
                   FontSize="12"
                   Foreground="#6B7280"
                   Text="{Binding VideoFiles.SelectedFolder.FullPath}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding VideoFiles.SelectedFolder.FullPath}"/>

                            <TextBlock Grid.Row="2"
                   Margin="0,5,0,8"
                   Foreground="#4B5563"
                   Text="{Binding VideoFiles.StatusText}"/>

                            <ListBox x:Name="VideoFilesList"
         Grid.Row="3"
         ItemsSource="{Binding VideoFiles.Files}"
         MouseDoubleClick="VideoFilesList_MouseDoubleClick"
                 BorderThickness="0"
                 Background="Transparent"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1"
                            ToolTip="{Binding FullPath}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="150"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Grid.Column="1"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="#4B5563"
                                       Text="{Binding Extension}"/>

                                                <TextBlock Grid.Column="2"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="#4B5563"
                                       Text="{Binding SizeBytes,
                                              StringFormat={}{0:N0} байт}"/>

                                                <TextBlock Grid.Column="3"
                                       VerticalAlignment="Center"
                                       Foreground="#4B5563"
                                       Text="{Binding LastWriteTimeUtc,
                                              StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>


                </Grid>
            </Border>

        </Grid>

        <Border Grid.Row="2"
                Padding="12,6"
                Background="White"
                BorderBrush="#D1D5DB"
                BorderThickness="0,1,0,0">
            <TextBlock Foreground="#4B5563"
                       Text="{Binding StatusText}"/>
        </Border>
    </Grid>
</Window>
